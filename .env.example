# Database (PostgreSQL). `npm run db:start` mengisi dua baris ini otomatis
# untuk PostgreSQL lokal proyek (port 54329).
DATABASE_URL="postgresql://postgres:password@localhost:54329/lockerpintar"
DATABASE_URL_TEST="postgresql://postgres:password@localhost:54329/lockerpintar_test"

# Better Auth: secret acak minimal 32 karakter, dan URL aplikasi.
# Buat secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="ganti-dengan-secret-acak"
BETTER_AUTH_URL="http://localhost:3000"
